# ==============================================================================
# Production Voice AI Receptionist - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiveKit Cloud / Server Configuration
# Get credentials at: https://cloud.livekit.io
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 2. AI Brain: Groq LPU Inference (OpenAI Compatible)
# Get API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
# Active production models on Groq: "openai/gpt-oss-120b" or "llama-3.3-70b-versatile"
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. Speech-to-Text (STT): Deepgram Streaming Nova-2
# Get API key at: https://console.deepgram.com
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 4. Text-to-Speech (TTS): Cartesia Sonic
# Get API key at: https://play.cartesia.ai
# ------------------------------------------------------------------------------
CARTESIA_API_KEY=your_cartesia_api_key_here

# Optional: Cartesia Voice ID. Defaults to "Katie" (friendly female receptionist):
# Katie: f786b574-daa5-4673-aa0c-cbe3e8534c02
# Commercial Man: 694f9389-aac1-45b6-b726-9d9369183238
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02

# ------------------------------------------------------------------------------
# 5. Google Calendar Service Account & Scheduling Settings
# ------------------------------------------------------------------------------
# Path to Google Service Account JSON key (default: credentials.json in project root)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Target Google Calendar ID.
# - Use "primary" to book directly into the Service Account's own calendar, OR
# - Use your business/personal Google Calendar ID (e.g. appointments@mycompany.com)
#   NOTE: If using a custom calendar, make sure to share it with the service account
#   email (client_email) with "Make changes to events" permission.
GOOGLE_CALENDAR_ID=primary

# Local Timezone for appointments (e.g., America/New_York, America/Los_Angeles, Asia/Kolkata, Europe/London)
TIMEZONE=America/New_York
